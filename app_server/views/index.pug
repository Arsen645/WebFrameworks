extends layout
include _includes/sharedHTMLfunctions

block content
  //- Hero section
  .hero
    .hero-content
      span.hero-kicker= hero.kicker
      h1= hero.title
      p= hero.subtitle
      a.btn.btn-primary(href=hero.cta.href)= hero.cta.label

  //- Main content
  .section-header
    span.section-label= features.label
    h2= features.title

  .feature-grid
    each card in features.cards
      a.feature-card(href=card.href)
        .feature-icon= card.icon
        .feature-content
          span.card-label= card.label
          h3= card.title
          p= card.text
          span.card-link= card.linkText

  //- Teams section
  .section-header.teams-header
    span.section-label= teamsSection.label
    h2= teamsSection.title

  .row.g-3
    each team in teams
      .col-12.col-md-6
        .card.h-100
          .card-body
            h4
              | #{team.name}
              small.ms-2
                +outputRating(team.rating)
              span.badge.rounded-pill.bg-dark.float-end #{team.titles} titles
            p.address #{team.stadium}, #{team.city}, #{team.country}
            .facilities
              each honour in team.honours
                span.badge.bg-success-subtle.text-success-emphasis.me-1= honour

  //- Intro section
  .intro-section
    .intro-content
      span.section-label= intro.label
      h2= intro.title
      p= intro.text
      a.text-link(href=intro.link.href)= intro.link.label