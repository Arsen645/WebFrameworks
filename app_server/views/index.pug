extends layout

block content
  //- Hero section
  .hero
    .hero-content
      span.hero-kicker= hero.kicker
      h1= hero.title
      p= hero.subtitle
      a.btn.btn-primary(href=hero.cta.href)= hero.cta.label

  //- Main content
  .section-header
    span.section-label= features.label
    h2= features.title

  .feature-grid
    each card in features.cards
      a.feature-card(href=card.href)
        .feature-icon= card.icon
        .feature-content
          span.card-label= card.label
          h3= card.title
          p= card.text
          span.card-link= card.linkText

  //- Intro section
  .intro-section
    .intro-content
      span.section-label= intro.label
      h2= intro.title
      p= intro.text
      a.text-link(href=intro.link.href)= intro.link.label